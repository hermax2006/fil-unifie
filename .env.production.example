# Copie ce fichier vers .env.production puis remplis les valeurs.
# NE COMMIT JAMAIS .env.production.

# Clé AES pour chiffrer les tokens (mots de passe IMAP, secrets webhook).
# Génère-en une : openssl rand -hex 32
TOKEN_ENC_KEY=change-moi-openssl-rand-hex-32

# URL publique du serveur (derrière le reverse proxy TLS).
# Doit correspondre EXACTEMENT à l'URI de redirection déclarée chez Google :
#   ${PUBLIC_BASE_URL}/auth/google/callback
PUBLIC_BASE_URL=https://ton-domaine.tld

# OAuth Google (Gmail en 1 clic). Créer un identifiant « Application Web » :
# https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : https://ton-domaine.tld/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook) : Azure AD → App registrations → Web.
# URI de redirection : https://ton-domaine.tld/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Slack : api.slack.com/apps → OAuth & Permissions.
# Redirect URL : https://ton-domaine.tld/auth/slack/callback
# Signing Secret : Basic Information → App Credentials (vérifie les webhooks).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Origine publique de l'app (https://ton-domaine.tld) — pour CORS si l'app
# est servie sur un autre domaine. Laisse vide si tout passe par nginx.
ALLOWED_ORIGINS=

# Port exposé du client nginx sur la machine hôte (devant un reverse proxy TLS : 8080).
WEB_PORT=8080
