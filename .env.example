# Environnement
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/fil_unifie
# Pour dev rapide: sqlite:./dev.db

# File d'événements : memory (défaut) ou bullmq
QUEUE_DRIVER=memory
# QUEUE_DRIVER=bullmq

# Redis (requis si QUEUE_DRIVER=bullmq)
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Chiffrement tokens OAuth (AES-256-GCM)
# Générer avec: openssl rand -hex 32
TOKEN_ENC_KEY=change_me_64_hex_chars

# CORS
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,tauri://localhost

# IA / Voix
GROQ_API_KEY=
GEMINI_API_KEY=

# Polling des sources distantes (RSS, IMAP...)
POLLING_DISABLED=false
POLL_INTERVAL_MS=60000
POLL_BACKOFF_BASE_MS=30000
POLL_BACKOFF_MAX_MS=1800000
